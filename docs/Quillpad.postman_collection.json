{
  "info": {
    "name": "Quillpad Blog API",
    "description": "Run the requests in order (top to bottom). Set the baseUrl variable if your server is not on port 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "postSlug",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create",
      "item": [
        {
          "name": "Create post (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Learning Express One Route At A Time\",\n  \"content\": \"Express routing becomes simple once you treat every route as a small, focused function.\",\n  \"author\": \"Your Name\",\n  \"category\": \"Backend\",\n  \"tags\": [\n    \"express\",\n    \"routing\"\n  ],\n  \"status\": \"published\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data; pm.collectionVariables.set('postId', d.id); pm.collectionVariables.set('postSlug', d.slug);",
                  "pm.test('Has slug and readingTime', () => pm.expect(pm.response.json().data).to.include.keys('slug','readingTime'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"x\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lists field errors', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post - malformed JSON (400)",
          "description": "Set the body to raw text like {oops and send.",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Read",
      "item": [
        {
          "name": "Get all posts (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has pagination meta', () => pm.expect(pm.response.json().meta).to.have.property('totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search + filter + sort + paginate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?search=rest&category=Backend&sort=views&order=desc&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "rest"
                },
                {
                  "key": "category",
                  "value": "Backend"
                },
                {
                  "key": "sort",
                  "value": "views"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get post by id (200)",
          "request": {
            "method": "GET",
            "header": [],
